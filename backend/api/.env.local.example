# Telepizza API — LOCAL development template
# Copy to backend/api/.env.local after `supabase start`
# NEVER point these at *.supabase.co for local ERP testing.

TELEPIZZA_ENV=local
API_JWT_SECRET=telepizza-local-jwt-secret-min-16
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# Local Supabase API (from `supabase status` — classic JWT keys)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

TELEPIZZA_REQUIRE_LOCAL_SUPABASE=1
TELEPIZZA_EMAIL_MODE=mock
TELEPIZZA_WHATSAPP_MODE=disabled
TELEPIZZA_PAYMENT_MODE=mock
TELEPIZZA_WEBHOOK_MODE=disabled

# Do NOT set TELEPIZZA_ALLOW_REMOTE_SUPABASE=1 for local development.
