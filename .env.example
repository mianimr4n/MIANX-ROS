# Website (Vite — local vs hosted)
# LOCAL: copy values into apps/website/.env.local from `supabase status`
# HOSTED: set on Vercel / hosting — never commit real keys

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-or-hosted-anon-jwt
VITE_API_BASE_URL=http://localhost:4000/api/v1
# VITE_GOOGLE_MAPS_API_KEY=

# Backend API
TELEPIZZA_ENV=local
API_PORT=4000
API_JWT_SECRET=change-me-min-16-chars
API_CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-or-hosted-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-local-or-hosted-service-role-jwt
TELEPIZZA_REQUIRE_LOCAL_SUPABASE=1
TELEPIZZA_EMAIL_MODE=mock
TELEPIZZA_WHATSAPP_MODE=disabled
TELEPIZZA_PAYMENT_MODE=mock
TELEPIZZA_WEBHOOK_MODE=disabled

# Staging / production (examples only — real secrets in host dashboards)
# TELEPIZZA_ENV=staging
# TELEPIZZA_ALLOW_REMOTE_SUPABASE=1
# SUPABASE_URL=https://your-project.supabase.co
# API_CORS_ORIGIN=https://your-frontend.example
