# Website (Vite — local vs hosted)
# LOCAL: copy values into apps/website/.env.local from `supabase status`
# HOSTED: set on Vercel / hosting — never commit real keys

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-or-hosted-anon-jwt
VITE_API_BASE_URL=http://localhost:4000/api/v1
# VITE_GOOGLE_MAPS_API_KEY=

# Backend API
TELEPIZZA_ENV=local
API_PORT=4000
API_JWT_SECRET=change-me-min-16-chars
API_CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-or-hosted-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-local-or-hosted-service-role-jwt
TELEPIZZA_REQUIRE_LOCAL_SUPABASE=1
TELEPIZZA_EMAIL_MODE=mock
TELEPIZZA_WHATSAPP_MODE=disabled
TELEPIZZA_PAYMENT_MODE=mock
TELEPIZZA_WEBHOOK_MODE=disabled

# AI integration mode (ADR-013 — backend-proxy-only).
#   disabled: AI features refuse to start (503 AI_DISABLED). Default for staging/production
#             until OPENAI_API_KEY / ANTHROPIC_API_KEY are provisioned (FU-12).
#   mock:     Deterministic stub responses; no HTTP to provider. Default for local/test.
#   sandbox:  Same as mock; provider tag = "sandbox".
#   live:     Real HTTP call to OpenAI / Anthropic via provider-proxy.ts.
#             NOT ALLOWED in local/test (safety blocker — use mock).
TELEPIZZA_AI_MODE=mock

# AI provider API keys (ADR-003 — secrets NEVER in DB; env vars only).
# Required when TELEPIZZA_AI_MODE=live. See FU-12 (Operator Follow-up).
# Provisioned by operator: insert ai_provider_configs rows + set these env vars.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Business Cloud API (ADR-003 — secrets NEVER in DB)
# Required when TELEPIZZA_WHATSAPP_MODE=sandbox|live
# Find these in Meta Business Manager → your WABA → Settings.
# WHATSAPP_ACCESS_TOKEN: System User token (long-lived). NEVER commit.
# WHATSAPP_PHONE_NUMBER_ID: phone_number_id from the WABA phone number.
# WHATSAPP_BUSINESS_ACCOUNT_ID: WABA ID (numeric, as string).
# WHATSAPP_APP_SECRET: App Secret from Meta App → Settings → Basic.
#   Used to verify X-Hub-Signature-256 HMAC-SHA256 on inbound webhooks.
# WHATSAPP_VERIFY_TOKEN: Any opaque string you choose. Meta sends this back
#   during the webhook subscription handshake (GET ?hub.verify_token=...).
# WHATSAPP_API_VERSION: Meta Graph API version (e.g. v21.0). Defaults to v21.0.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0

# Staging / production (examples only — real secrets in host dashboards)
# TELEPIZZA_ENV=staging
# TELEPIZZA_ALLOW_REMOTE_SUPABASE=1
# SUPABASE_URL=https://your-project.supabase.co
# API_CORS_ORIGIN=https://your-frontend.example
