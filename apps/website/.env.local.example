# Telepizza Website — LOCAL development template
# Copy to apps/website/.env.local after local Supabase is running.
# NEVER point these at *.supabase.co for local ERP testing.

VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# OAuth / maps optional for local ERP — leave unset to disable
# VITE_GOOGLE_OAUTH_ENABLED=false
# VITE_FACEBOOK_OAUTH_ENABLED=false
# VITE_GOOGLE_MAPS_API_KEY=
