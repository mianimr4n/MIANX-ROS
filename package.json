{
  "name": "telepizza-platform",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev:website": "pnpm --filter telepizza-pakistan dev",
    "build:website": "pnpm --filter telepizza-pakistan build",
    "check:website": "pnpm --filter telepizza-pakistan check",
    "check:backend": "pnpm --filter @telepizza/api check",
    "test:db": "node --test tests/database/**/*.test.mjs tests/menu/**/*.test.mjs tests/website/**/*.test.mjs tests/catalog/**/*.test.mjs",
    "catalog:build": "node scripts/build-canonical-menu.mjs",
    "catalog:generate-fallback": "node scripts/generate-menu-fallback-from-canonical.mjs",
    "catalog:dry-run": "node scripts/dry-run-canonical-menu-migration.mjs",
    "test:backend": "pnpm --filter @telepizza/api test",
    "check": "pnpm check:website && pnpm check:backend",
    "test": "pnpm test:db && pnpm test:backend",
    "local": "node scripts/local-up.mjs",
    "local:guard": "node scripts/local-env-guard.mjs",
    "local:health": "node scripts/local-health-check.mjs",
    "local:env": "node scripts/write-local-env-from-supabase.mjs",
    "local:seed": "node scripts/seed-local-enterprise.mjs",
    "local:start": "node scripts/local-lifecycle.mjs start",
    "local:stop": "node scripts/local-lifecycle.mjs stop",
    "local:reset": "node scripts/local-lifecycle.mjs reset",
    "local:status": "node scripts/local-lifecycle.mjs status"
  },
  "pnpm": {
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
